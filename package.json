{
  "name": "vector-pose",
  "productName": "vector-pose",
  "version": "1.0.2",
  "private": true,
  "description": "Skeletal rigging software for Electron and the web",
  "main": ".vite/build/main.js",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "build:web": "vite build --config vite.web.config.mts",
    "preview:web": "vite preview --config vite.web.config.mts",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "lint": "oxlint --type-aware --deny-warnings --report-unused-disable-directives .",
    "lint:fix": "oxlint --type-aware --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "check": "npm run format:check && npm run lint && npm run typecheck"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron-forge/publisher-github": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^44.4.5",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2003",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "keywords": [],
  "author": {
    "name": "bluehexagons",
    "email": "bluehexagons@users.noreply.github.com"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.9.0"
  },
  "packageManager": "npm@12.1.0",
  "allowScripts": {
    "electron-winstaller@5.4.4": true
  },
  "overrides": {
    "@electron/packager": "^18.4.4",
    "@electron/rebuild": "^4.2.0",
    "extract-zip": "npm:@electron-internal/extract-zip@^1.0.1",
    "tmp": "^0.2.7"
  },
  "dependencies": {
    "@bluehexagons/easing": "^0.4.2",
    "electron-squirrel-startup": "^1.0.1",
    "gl-matrix": "^3.4.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "update-electron-app": "^3.3.0",
    "zod": "^4.6.5"
  }
}
