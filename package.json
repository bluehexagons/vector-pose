{
  "name": "vector-pose",
  "productName": "vector-pose",
  "version": "1.0.2",
  "private": true,
  "description": "Skeletal rigging software for Electron and the web",
  "main": ".vite/build/main.cjs",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge release",
    "dev:web": "vite --config vite.web.config.mts",
    "build:web": "vite build --config vite.web.config.mts",
    "preview:web": "vite preview --config vite.web.config.mts",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "lint": "oxlint --type-aware --deny-warnings --report-unused-disable-directives .",
    "lint:fix": "oxlint --type-aware --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "check": "npm run format:check && npm run lint && npm run typecheck"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@electron-forge/publisher-github": "^8.0.1",
    "@electron-forge/shared-types": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^45.0.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2004",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "keywords": [],
  "author": {
    "name": "bluehexagons",
    "email": "bluehexagons@users.noreply.github.com"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": "^24.22.1 || ^26.12.1",
    "npm": ">=10.9.0"
  },
  "packageManager": "npm@12.2.1",
  "allowScripts": {
    "electron-winstaller@5.4.4": true
  },
  "overrides": {
    "extract-zip": "npm:@electron-internal/extract-zip@^1.0.6",
    "tmp": "^0.2.7"
  },
  "dependencies": {
    "@bluehexagons/easing": "^0.4.2",
    "electron-squirrel-startup": "^1.0.1",
    "gl-matrix": "^3.4.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "update-electron-app": "^3.3.0",
    "zod": "^4.6.7"
  }
}
